---
interface Props { mode: string; label: string; }
const { mode, label } = Astro.props;
const audio = ['MIC IN', 'BUFFER', 'STT', 'TRANSLATE', 'TTS', 'VIRTUAL MIC'];
---
<div class:list={['diagram', `diagram-${mode}`]} data-scene={mode}>
  <div class="diagram-top"><span>{mode === 'hero' ? 'SYSTEM TOPOLOGY' : mode === 'audio' ? 'AUDIO SIGNAL PATH' : mode === 'radar' ? 'DEPENDENCY GRAPH' : mode === 'mapping' ? 'SCHEMA MAPPING' : 'EXECUTION TRACE'}</span><span class="diagram-index">{mode === 'hero' ? 'FIG. 00' : 'SCHEMATIC'}</span></div>
  {mode === 'hero' ? <svg class="topology" viewBox="0 0 640 570" fill="none" aria-hidden="true">
    <defs><radialGradient id="globe-glow"><stop stop-color="#5fb7cb" stop-opacity=".14"/><stop offset="1" stop-color="#5fb7cb" stop-opacity="0"/></radialGradient></defs>
    <circle cx="320" cy="275" r="248" fill="url(#globe-glow)"/>
    <g stroke="#49616d" stroke-width=".6">
      <ellipse cx="320" cy="275" rx="192" ry="192"/>
      {[35,75,120,165].map(rx => <ellipse cx="320" cy="275" rx={rx} ry="192" transform="rotate(-25 320 275)"/>)}
      {[-135,-85,-30,30,85,135].map(y => <ellipse cx="320" cy={275+y} rx={Math.sqrt(192*192-y*y)} ry="33" transform="rotate(-25 320 275)"/>)}
    </g>
    <g stroke="#8ddaea" stroke-width="1"><path d="M155 186L254 149L366 213L420 340L276 388L198 298Z M254 149L198 298L366 213L276 388 M366 213L491 225L420 340"/></g>
    <g fill="#b4e9f1">{[[155,186],[254,149],[366,213],[420,340],[276,388],[198,298],[491,225]].map(([cx,cy])=><circle cx={cx} cy={cy} r="3"/>)}</g>
    <g stroke="#58616a" stroke-width=".7"><path d="M155 186L105 136H35M491 225L545 170H604M276 388L206 463H72"/><circle cx="320" cy="275" r="226" stroke-dasharray="2 12"/></g>
    <g fill="#abb8c0" font-size="10" font-family="monospace"><text x="35" y="126">CONTEXT</text><text x="550" y="160">SYSTEM</text><text x="72" y="480">EVIDENCE</text></g>
  </svg> : mode === 'audio' ? <div class="audio-visual">
    <svg viewBox="0 0 640 220" fill="none" aria-hidden="true"><g stroke="#203743" stroke-width=".5">{[40,80,120,160,200].map(y=><path d={`M0 ${y}H640`}/>)}</g>
    {Array.from({length:112},(_,i)=> {const h=8+Math.pow(Math.sin(i*.19),2)*Math.sin(i/112*Math.PI)*120; return <line x1={i*5.7} x2={i*5.7} y1={110-h/2} y2={110+h/2} stroke={i<60?'#90d2df':'#47617b'} stroke-width="2"/>;})}</svg>
    <ol class="pipeline">{audio.map((a,i)=><li><span>{String(i+1).padStart(2,'0')}</span><b>{a}</b></li>)}</ol>
    <div class="diagram-readout"><span>BOUNDED BUFFER</span><span>REPLACEABLE ENGINES</span><span>LOCAL-FIRST</span></div>
  </div> : mode === 'radar' ? <svg class="system-svg" viewBox="0 0 640 330" role="img" aria-label="Service → DAO → SQL → TABLE → COLUMN. HIGH / UNKNOWN.">
    <g fill="none" stroke="#34414c"><path d="M85 95L220 80L355 160L485 95M85 250L220 250L355 160L485 245"/></g>
    <g fill="none" stroke="#83cbd9" stroke-width="2" class="evidence-path"><path d="M85 95L220 80L355 160L485 245L570 245"/></g>
    {[[85,95,'Service'],[220,80,'DAO'],[355,160,'SQL'],[485,95,'TABLE'],[485,245,'COLUMN'],[85,250,'Service'],[220,250,'DAO']].map(([x,y,t])=><g><circle cx={x} cy={y} r="8" fill="#101b23" stroke="#8ba9ba"/><text x={x} y={Number(y)-20} fill="#d8e0e5" text-anchor="middle">{t}</text></g>)}
    <g fill="#8ed3df" font-size="11"><text x="305" y="211">PedidoDAO.java:42</text><text x="469" y="285">STATUS / HIGH</text></g><text x="89" y="291" fill="#a4aeb8" font-size="11">dynamic SQL / UNKNOWN</text>
  </svg> : mode === 'mapping' ? <svg class="system-svg" viewBox="0 0 640 330" role="img" aria-label="Nome → customer.name; CPF → taxId; Email → email; Data → createdAt. Explicit review.">
    <g fill="none" stroke="#608b9b">{[60,125,190,255].map((y,i)=><path class="mapping-line" d={`M205 ${y}C300 ${y} 325 ${y+(i===3?-15:0)} 415 ${y}`}/>)}</g>
    {['Nome','CPF','Email','Data'].map((t,i)=><g><rect x="35" y={40+i*65} width="170" height="40" fill="#111b23" stroke="#34414d"/><text x="53" y={65+i*65} fill="#e4e9ed">{t}</text><rect x="415" y={40+i*65} width="190" height="40" fill="#111b23" stroke="#34414d"/><text x="430" y={65+i*65} fill="#e4e9ed">{['customer.name','taxId','email','createdAt'][i]}</text><text x="260" y={51+i*65} fill={i===3?'#d9ae6e':'#90c9d4'} font-size="10">{i===3?'REVIEW':'CONFIRMED'}</text></g>)}
  </svg> : <svg class="system-svg" viewBox="0 0 640 330" role="img" aria-label="request → controller → service → DAO → database. Local JSONL recording.">
    <g stroke="#293744">{[180,260,340,420,500,580].map(x=><path d={`M${x} 35V290`}/>)}</g>
    {['request','controller','service','DAO','database'].map((t,i)=><g><text x="25" y={62+i*48} fill="#c5d0d9">{t}</text><rect class="trace-bar" x={180+i*28} y={47+i*48} width={385-i*67} height="17" rx="2" fill={i===4?'#b99561':'#608d9d'} fill-opacity={.35+i*.12}/><circle cx={180+i*28} cy={55+i*48} r="3" fill="#bcdee6"/></g>)}<text x="181" y="309" fill="#9aa7b3" font-size="10">OBSERVED EVENTS → LOCAL JSONL</text>
  </svg>}
  <div class="diagram-bottom"><span>{label}</span><span aria-hidden="true">＋</span></div>
</div>
