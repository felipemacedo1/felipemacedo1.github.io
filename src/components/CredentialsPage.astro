---
import { copy, profile, type Locale } from '../content/profile';
import credentials from '../data/credentials.generated.json';
import editorial from '../content/credential-editorial.json';
import certificates from '../content/certificates.json';
import '../styles/global.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
const isPortuguese = locale === 'pt';
const pagePath = isPortuguese ? '/credenciais/' : '/en/credentials/';
const formatDate = (date: string) =>
  new Intl.DateTimeFormat(t.lang, {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(date));
const groups = isPortuguese
  ? ['certificação profissional', 'aprendizagem', 'experiência']
  : ['professional certification', 'learning', 'experience'];
const certificatesWithFiles = certificates;
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{isPortuguese ? 'Credenciais' : 'Credentials'} — Felipe Macedo</title>
    <meta
      name="description"
      content={
        isPortuguese
          ? 'Credenciais verificáveis e certificados de formação de Felipe Macedo.'
          : 'Verifiable credentials and training certificates from Felipe Macedo.'
      }
    />
    <link rel="canonical" href={`${profile.site}${pagePath}`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="credentials-page">
    <a class="skip" href="#main">
      {t.skip}
    </a>
    <header class="header">
      <a class="brand" href={isPortuguese ? '/' : '/en/'} aria-label={`Felipe Macedo — ${t.top}`}>
        <span class="brand-mark" aria-hidden="true">
          f<span>m</span>
          <i></i>
        </span>
        <span>Felipe Macedo</span>
      </a>
      <nav aria-label={isPortuguese ? 'Navegação da página' : 'Page navigation'}>
        <a href={isPortuguese ? '/' : '/en/'}>{isPortuguese ? 'Portfólio' : 'Portfolio'}</a>
        <a href={isPortuguese ? '/curriculo/' : '/en/resume/'}>{t.resume}</a>
      </nav>
      <div class="languages" aria-label="Language">
        <a href="/credenciais/" lang="pt-BR" aria-current={isPortuguese ? 'page' : undefined}>
          PT
        </a>
        <span>/</span>
        <a href="/en/credentials/" lang="en" aria-current={!isPortuguese ? 'page' : undefined}>
          EN
        </a>
      </div>
    </header>
    <main id="main" class="credentials-main wrap">
      <p class="eyebrow">
        04 / {isPortuguese ? 'FORMAÇÃO & CREDENCIAIS' : 'EDUCATION & CREDENTIALS'}
      </p>
      <div class="document-heading">
        <div>
          <h1>{isPortuguese ? 'Credenciais verificáveis.' : 'Verifiable credentials.'}</h1>
          <p>
            {isPortuguese
              ? 'Dados oficiais do Credly permanecem separados das descrições editoriais que explicam sua relevância.'
              : 'Official Credly data remains separate from the editorial descriptions that explain its relevance.'}
          </p>
        </div>
        <a class="button" href={isPortuguese ? '/' : '/en/'}>
          ← {isPortuguese ? 'Voltar ao portfólio' : 'Back to portfolio'}
        </a>
      </div>
      {groups.map((group) => {
        const items = credentials.filter(
          (badge) =>
            (editorial[badge.id as keyof typeof editorial]?.category?.[locale] ?? '') === group,
        );
        if (!items.length) return null;
        return (
          <section class="credential-group" aria-labelledby={`group-${group.replaceAll(' ', '-')}`}>
            <div class="document-section-label">
              <span class="mono">{String(items.length).padStart(2, '0')} ITEMS</span>
              <h2 id={`group-${group.replaceAll(' ', '-')}`}>{group}</h2>
            </div>
            <div class="credential-list">
              {items.map((badge) => {
                const meta = editorial[badge.id as keyof typeof editorial];
                const certificate = meta && 'certificate' in meta ? meta.certificate : undefined;
                return (
                  <article class="credential credential-detail">
                    <div class="credential-head">
                      {'localImage' in badge && (
                        <img
                          src={String(badge.localImage)}
                          width="64"
                          height="64"
                          loading="lazy"
                          alt=""
                        />
                      )}
                      <p class="mono">{badge.issuer}</p>
                    </div>
                    <p class="credential-category mono">{meta?.category?.[locale]}</p>
                    <h3>{badge.name}</h3>
                    <p>{meta?.description?.[locale] ?? badge.description}</p>
                    <dl>
                      <div>
                        <dt>{isPortuguese ? 'Emissão' : 'Issued'}</dt>
                        <dd>{badge.issuedAt ? formatDate(badge.issuedAt) : t.unknownDate}</dd>
                      </div>
                    </dl>
                    <div class="credential-links">
                      <a href={badge.url} target="_blank" rel="noreferrer">
                        {t.verify} ↗
                      </a>
                      {certificate && (
                        <a href={certificate.asset} target="_blank" rel="noreferrer">
                          {certificate.label[locale]} ↗
                        </a>
                      )}
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        );
      })}
      {certificatesWithFiles.length > 0 && (
        <section class="credential-group certificate-group">
          <div class="document-section-label">
            <span class="mono">
              {String(certificatesWithFiles.length).padStart(2, '0')} DOCUMENTS
            </span>
            <h2>{isPortuguese ? 'Certificados visuais' : 'Visual certificates'}</h2>
          </div>
          <div class="certificate-grid">
            {certificatesWithFiles.map((certificate) => (
              <details class="certificate-card">
                <summary>
                  <span>
                    <strong>{certificate.title[locale]}</strong>
                    <small>
                      {certificate.issuer} · {certificate.category[locale]}
                      {certificate.hours ? ` · ${certificate.hours}h` : ''}
                    </small>
                  </span>
                  <span aria-hidden="true">+</span>
                </summary>
                <div class="certificate-body">
                  <img
                    src={certificate.asset}
                    width="1200"
                    height="850"
                    loading="lazy"
                    alt={certificate.title[locale]}
                  />
                  <p>
                    {certificate.description?.[locale] ??
                      (isPortuguese
                        ? 'Certificado visual fornecido pelo emissor.'
                        : 'Visual certificate supplied by the issuer.')}
                  </p>
                  <a href={certificate.asset} target="_blank" rel="noreferrer">
                    {isPortuguese ? 'Abrir original' : 'Open original'} ↗
                  </a>
                </div>
              </details>
            ))}
          </div>
        </section>
      )}
    </main>
    <footer class="wrap footer">
      <div>
        <a href={isPortuguese ? '/' : '/en/'} class="brand">
          Felipe Macedo<span aria-hidden="true">↗</span>
        </a>
        <p>{t.footer}</p>
      </div>
      <span class="mono">© {new Date().getFullYear()} / FM</span>
    </footer>
  </body>
</html>
