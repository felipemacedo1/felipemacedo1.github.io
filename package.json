{
  "name": "felipe-engineering-portfolio",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/validate-dist.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "lint": "astro check",
    "sync:credly": "node scripts/sync-credly.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lighthouse": "lighthouse http://localhost:4321 --output=json --output-path=./test-results/lighthouse.json --chrome-flags=\"--headless --no-sandbox\""
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "astro": "^7.3.4",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.0.1",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3"
  }
}
